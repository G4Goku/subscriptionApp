# Copy to .env and fill in real values.

PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/netflixClone

# Secret used to sign and verify auth tokens
JWT_TOKEN=

# Stripe secret key (sk_test_... in development)
STRIPE_SECRET_KEY=

# Where Stripe Checkout returns the user. These must point at the client's
# subscription result routes; the server appends session_id to the success url
# so the app can confirm the checkout it just came back from.
STRIPE_SUCCESS_URL=http://localhost:3000/subscription/success
STRIPE_CANCEL_URL=http://localhost:3000/subscription/cancel

MOVIE_DB_BASE_URL=https://api.themoviedb.org/3
MOVIE_DB_API_KEY=
